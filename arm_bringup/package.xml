<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arm_bringup</name>
  <version>0.1.0</version>
  <description> 
    This is the bringup package for the robotic arm. It starts everything the robot arm needs to run (other launch files, rviz configs, etc.).
  </description>
  <maintainer email="nicolascacfl@gmail.com">nicoc144</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <depend>arm_description</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
